{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "employee_health_profiles",
  "description": "직원 건강·신체 정보 (FR-F1, 민감정보 분리 저장)",
  "columns": [
    { "name": "health_profile_id", "type": "big_int", "nullable": false, "primary_key": { "auto_increment": true }, "comment": "건강정보 고유번호" },
    { "name": "employee_id", "type": "big_int", "nullable": false, "unique": true, "foreign_key": { "references": "employees.employee_id", "on_delete": "cascade" }, "comment": "직원 FK (1:1)" },
    { "name": "height_cm", "type": "integer", "nullable": true, "comment": "신장(cm)" },
    { "name": "weight_kg", "type": "integer", "nullable": true, "comment": "체중(kg)" },
    { "name": "has_asthma", "type": "boolean", "nullable": false, "default": false, "comment": "천식 보유 여부" },
    { "name": "has_claustrophobia", "type": "boolean", "nullable": false, "default": false, "comment": "폐쇄공포 보유 여부" },
    { "name": "allergens", "type": "jsonb", "nullable": true, "comment": "알레르기 유발물질 코드 배열 (예: [\"RICE\"])" },
    { "name": "other_conditions", "type": "text", "nullable": true, "comment": "기타 특이사항" },
    { "name": "consent_agreed", "type": "boolean", "nullable": false, "default": false, "comment": "개인정보(건강) 수집·이용 동의" },
    { "name": "consent_at", "type": "timestamptz", "nullable": true, "comment": "동의 시각" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "생성일시" },
    { "name": "updated_at", "type": "timestamptz", "nullable": true, "comment": "수정일시" }
  ]
}
