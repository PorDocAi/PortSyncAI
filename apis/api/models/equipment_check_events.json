{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "equipment_check_events",
  "description": "작업 배정 범위의 append-only 장비 태깅·멱등 응답 이벤트",
  "columns": [
    {"name": "equipment_check_event_id", "type": "big_int", "nullable": false, "primary_key": {"auto_increment": true}, "comment": "장비 태깅 이벤트 고유번호"},
    {"name": "employee_id", "type": "big_int", "nullable": false, "foreign_key": "employees.employee_id", "unique": "uq_equipment_check_employee_idempotency", "index": true, "comment": "JWT로 확인한 작업자 FK"},
    {"name": "work_assignment_id", "type": "big_int", "nullable": false, "foreign_key": "work_assignments.assignment_id", "index": true, "comment": "요청 작업 배정 FK"},
    {"name": "equipment_id", "type": "big_int", "nullable": true, "foreign_key": {"references": "equipment.equipment_id", "on_delete": "set_null"}, "comment": "토큰으로 확인한 장비 FK, 미확인 토큰은 null"},
    {"name": "idempotency_key", "type": "uuid", "nullable": false, "unique": "uq_equipment_check_employee_idempotency", "comment": "작업자 범위 멱등키"},
    {"name": "request_fingerprint", "type": {"kind": "char", "length": 64}, "nullable": false, "comment": "정규화하지 않은 요청의 SHA-256 지문"},
    {"name": "http_status", "type": "small_int", "nullable": false, "comment": "최초 응답 HTTP 상태"},
    {"name": "accepted", "type": "boolean", "nullable": false, "comment": "장비 태깅 수락 여부"},
    {"name": "reason_code", "type": {"kind": "varchar", "length": 64}, "nullable": false, "comment": "안정된 결과 코드"},
    {"name": "response_json", "type": "json", "nullable": false, "comment": "재전송할 최초 정확 응답 JSON"},
    {"name": "client_scanned_at", "type": "timestamptz", "nullable": false, "comment": "클라이언트 스캔 감사시각"},
    {"name": "occurred_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "서버 이벤트 발생일시"}
  ]
}
