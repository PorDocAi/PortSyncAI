{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "container_cargo_items",
  "description": "컨테이너와 혼재 화물의 다대다 관계",
  "columns": [
    {"name": "container_cargo_item_id", "type": "big_int", "nullable": false, "primary_key": {"auto_increment": true}, "comment": "컨테이너 화물 관계 고유번호"},
    {"name": "container_id", "type": "big_int", "nullable": false, "foreign_key": {"references": "containers.container_id", "on_delete": "cascade"}, "unique": "uq_container_cargo_item", "comment": "컨테이너 FK"},
    {"name": "cargo_item_id", "type": "big_int", "nullable": false, "foreign_key": {"references": "cargo_items.cargo_item_id", "on_delete": "cascade"}, "unique": "uq_container_cargo_item", "comment": "화물 FK"},
    {"name": "loaded_at", "type": "timestamptz", "nullable": true, "comment": "적재 확인일시"},
    {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "생성일시"}
  ]
}
