{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "gate_terminals",
  "description": "게이트 단말 자격증명(PR #48 보존)",
  "columns": [
    {
      "comment": "단말 고유번호",
      "name": "terminal_id",
      "nullable": false,
      "primary_key": {
        "auto_increment": true
      },
      "type": "big_int"
    },
    {
      "comment": "게이트 식별자 (예: 북문, 남문)",
      "name": "gate_id",
      "nullable": false,
      "type": {
        "kind": "varchar",
        "length": 100
      }
    },
    {
      "comment": "단말 토큰 SHA-256 해시 (평문 저장 금지)",
      "name": "token_hash",
      "nullable": false,
      "type": {
        "kind": "char",
        "length": 64
      },
      "unique": true
    },
    {
      "comment": "활성 여부 (폐기 시 false — 소프트 삭제)",
      "default": true,
      "name": "is_active",
      "nullable": false,
      "type": "boolean"
    },
    {
      "comment": "생성일시",
      "default": "NOW()",
      "name": "created_at",
      "nullable": false,
      "type": "timestamptz"
    }
  ]
}
