{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "gate_terminals",
  "description": "게이트 단말 자격증명(PR #48 보존)",
  "columns": [
    {"name": "terminal_id", "type": "big_int", "nullable": false, "primary_key": {"auto_increment": true}, "comment": "단말 고유번호"},
    {"name": "gate_id", "type": {"kind": "varchar", "length": 100}, "nullable": false, "comment": "게이트 식별자"},
    {"name": "token_hash", "type": {"kind": "char", "length": 64}, "nullable": false, "unique": true, "comment": "단말 토큰 SHA-256 해시"},
    {"name": "is_active", "type": "boolean", "nullable": false, "default": true, "comment": "활성 여부"},
    {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "생성일시"}
  ]
}
