    {"name": "equipment_profile_id", "type": "big_int", "nullable": false, "foreign_key": {"references": "equipment_profiles.equipment_profile_id", "on_delete": "cascade"}, "unique": ["uq_shared_equipment_assignment", "uq_shared_equipment_active_claim"], "comment": "점유 v2 공용 장비 프로필 FK"},
    {"name": "claimed_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "점유 시작일시"}
