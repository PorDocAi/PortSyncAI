{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "improvement_orders",
  "description": "항만안전점검관 개선명령 워크플로 (FR-E3, 3단계)",
  "columns": [
    { "name": "order_id", "type": "big_int", "nullable": false, "primary_key": { "auto_increment": true }, "comment": "개선명령 고유번호" },
    { "name": "issued_by", "type": "big_int", "nullable": false, "foreign_key": "employees.employee_id", "comment": "명령 등록자 FK (관리자/점검관)" },
    { "name": "target_employee_id", "type": "big_int", "nullable": true, "foreign_key": { "references": "employees.employee_id", "on_delete": "set_null" }, "comment": "대상 작업자 FK" },
    { "name": "attendance_id", "type": "big_int", "nullable": true, "foreign_key": { "references": "attendances.attendance_id", "on_delete": "set_null" }, "comment": "관련 출근 FK" },
    { "name": "content", "type": "text", "nullable": false, "comment": "개선명령 내용" },
    { "name": "status", "type": { "kind": "enum", "name": "improvement_status", "values": ["ISSUED", "ACTION_TAKEN", "COMPLETED"] }, "nullable": false, "default": "'ISSUED'", "comment": "진행 상태 (등록→조치→완료)" },
    { "name": "action_photo_url", "type": { "kind": "varchar", "length": 500 }, "nullable": true, "comment": "조치 사진 경로 (FR-E3)" },
    { "name": "action_taken_at", "type": "timestamptz", "nullable": true, "comment": "조치 시각" },
    { "name": "completed_at", "type": "timestamptz", "nullable": true, "comment": "완료 보고 시각" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "생성일시" },
    { "name": "updated_at", "type": "timestamptz", "nullable": true, "comment": "수정일시" }
  ]
}
