{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "work_assignments",
  "description": "레거시 작업 배치와 부가적인 v2 작업 연결",
  "columns": [
    {"name": "assignment_id", "type": "big_int", "nullable": false, "primary_key": {"auto_increment": true}, "comment": "배치 고유번호"},
    {"name": "employee_id", "type": "big_int", "nullable": false, "foreign_key": "employees.employee_id", "index": true, "comment": "작업자 FK"},
    {"name": "work_date", "type": "date", "nullable": false, "index": true, "comment": "작업 일자"},
    {"name": "cargo_item_id", "type": "big_int", "nullable": true, "foreign_key": {"references": "cargo_items.cargo_item_id", "on_delete": "set_null"}, "comment": "대상 화물 FK"},
    {"name": "assigned_by_id", "type": "big_int", "nullable": false, "foreign_key": "employees.employee_id", "comment": "배치 담당자 FK"},
    {"name": "eligibility_status", "type": {"kind": "enum", "name": "eligibility_status", "values": ["ELIGIBLE", "EXCLUDED"]}, "nullable": false, "default": "'ELIGIBLE'", "comment": "투입 가능 여부 (제한규칙 대조 결과)"},
    {"name": "v2_work_id", "type": "big_int", "nullable": true, "foreign_key": {"references": "works.work_id", "on_delete": "set_null"}, "index": true, "comment": "부가 v2 작업 FK, 변환 불가 레거시는 null; 활성화 시 애플리케이션 트랜잭션 검증"},
    {"name": "status", "type": {"kind": "enum", "name": "work_assignment_status", "values": ["ASSIGNED", "SELECTED", "ACTIVE", "COMPLETED", "CANCELLED"]}, "nullable": false, "default": "'ASSIGNED'", "index": true, "comment": "배정 수명주기 상태"},
    {"name": "selected_at", "type": "timestamptz", "nullable": true, "comment": "작업자가 NFC 대상 작업으로 선택한 일시"},
    {"name": "started_at", "type": "timestamptz", "nullable": true, "comment": "배정 작업 시작일시"},
    {"name": "completed_at", "type": "timestamptz", "nullable": true, "comment": "배정 작업 완료일시"},
    {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "생성일시"},
    {"name": "updated_at", "type": "timestamptz", "nullable": true, "comment": "수정일시"}
  ]
}
