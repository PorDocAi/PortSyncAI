{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "work_preparations",
  "description": "출근 전역 불리언을 대체하는 작업 배정별 준비 상태",
  "columns": [
    {"name": "work_preparation_id", "type": "big_int", "nullable": false, "primary_key": {"auto_increment": true}, "comment": "작업 준비 고유번호"},
    {"name": "work_assignment_id", "type": "big_int", "nullable": false, "foreign_key": {"references": "work_assignments.work_assignment_id", "on_delete": "cascade"}, "unique": true, "comment": "작업 배정 FK"},
    {"name": "status", "type": {"kind": "enum", "name": "work_preparation_status", "values": ["NOT_STARTED", "IN_PROGRESS", "READY", "BLOCKED"]}, "nullable": false, "default": "'NOT_STARTED'", "index": true, "comment": "종합 준비 상태"},
    {"name": "document_ready", "type": "boolean", "nullable": false, "default": false, "comment": "관련 문서 검수 충족 여부"},
    {"name": "education_ready", "type": "boolean", "nullable": false, "default": false, "comment": "교육 이수 충족 여부"},
    {"name": "instruction_ready", "type": "boolean", "nullable": false, "default": false, "comment": "작업 지침 확인 여부"},
    {"name": "ppe_ready", "type": "boolean", "nullable": false, "default": false, "comment": "보호구 준비 충족 여부"},
    {"name": "decision_input_versions", "type": "json", "nullable": false, "comment": "준비 판정 입력 버전"},
    {"name": "prepared_at", "type": "timestamptz", "nullable": true, "comment": "준비 완료일시"},
    {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "생성일시"},
    {"name": "updated_at", "type": "timestamptz", "nullable": true, "comment": "수정일시"}
  ]
}
