{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "audit_logs",
  "description": "감사 로그 (FR-G1, append-only — 누가/언제/무엇을/어떤 버전, NFR 무결성)",
  "columns": [
    { "name": "audit_log_id", "type": "big_int", "nullable": false, "primary_key": { "auto_increment": true }, "comment": "감사 로그 고유번호" },
    { "name": "actor_employee_id", "type": "big_int", "nullable": true, "foreign_key": { "references": "employees.employee_id", "on_delete": "set_null" }, "index": true, "comment": "행위자 FK (시스템 이벤트는 null)" },
    { "name": "event_type", "type": { "kind": "varchar", "length": 50 }, "nullable": false, "index": true, "comment": "이벤트 유형 (INSTRUCTION_ACK/EQUIPMENT_CHECK/APPROVAL/GATE_PASS 등)" },
    { "name": "target_type", "type": { "kind": "varchar", "length": 50 }, "nullable": true, "comment": "대상 엔티티명" },
    { "name": "target_id", "type": "big_int", "nullable": true, "comment": "대상 레코드 PK" },
    { "name": "instruction_version", "type": "integer", "nullable": true, "comment": "관련 지침 버전 (FR-G1)" },
    { "name": "detail", "type": "json", "nullable": true, "comment": "상세 이벤트 데이터" },
    { "name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "발생 시각" }
  ]
}
