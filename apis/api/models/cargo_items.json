{
  "$schema": "https://raw.githubusercontent.com/dev-five-git/vespertide/refs/heads/main/schemas/model.schema.json",
  "name": "cargo_items",
  "description": "컨테이너에 혼재 가능한 화물 단위",
  "columns": [
    {"name": "cargo_item_id", "type": "big_int", "nullable": false, "primary_key": {"auto_increment": true}, "comment": "화물 고유번호"},
    {"name": "bl_number", "type": {"kind": "varchar", "length": 50}, "nullable": true, "comment": "선하증권 번호"},
    {"name": "dgd_number", "type": {"kind": "varchar", "length": 50}, "nullable": true, "comment": "위험물신고서 번호"},
    {"name": "un_number", "type": {"kind": "char", "length": 4}, "nullable": true, "comment": "UN 번호"},
    {"name": "dg_class_id", "type": "big_int", "nullable": true, "foreign_key": {"references": "dg_classes.dg_class_id", "on_delete": "set_null"}, "index": true, "comment": "확정 위험물 등급 FK"},
    {"name": "hs_code", "type": {"kind": "varchar", "length": 20}, "nullable": true, "comment": "HS Code"},
    {"name": "item_name", "type": {"kind": "varchar", "length": 255}, "nullable": true, "comment": "화물명"},
    {"name": "description", "type": "text", "nullable": true, "comment": "화물 상세"},
    {"name": "is_dangerous", "type": "boolean", "nullable": false, "default": false, "comment": "위험물 여부"},
    {"name": "dgd_missing_warning", "type": "boolean", "nullable": false, "default": false, "comment": "DGD 누락 경고"},
    {"name": "arrival_date", "type": "date", "nullable": true, "index": true, "comment": "입항일"},
    {"name": "created_at", "type": "timestamptz", "nullable": false, "default": "NOW()", "comment": "생성일시"},
    {"name": "updated_at", "type": "timestamptz", "nullable": true, "comment": "수정일시"}
  ]
}
